# systemd unit for the monitor and its API.
#
#   sudo cp power-status.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now power-status
#   journalctl -u power-status -f
#
# Runs as root: no User= below, so nothing has to exist before it starts.
#
# The binary has the contents of src/config.rs compiled into it, private key
# included, so neither it nor the checkout should be world-readable.

[Unit]
Description=power-status monitor and API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/opt/power-status/target/release/power-status

# DB_PATH and DB_BACKUP_PATH are relative ("./status.db"), so this decides
# where the database lives. Without it systemd starts the process in / and it
# opens a database there instead.
WorkingDirectory=/opt/power-status

# EnvFilter falls back to ERROR when RUST_LOG is unset, which hides every info
# line the service emits. Raise it to debug to see why a monitor was marked
# down -- that reason is logged at debug and is otherwise invisible.
Environment=RUST_LOG=info

Restart=always
RestartSec=5

# No capability grants needed: the raw ICMP socket the internet monitor falls
# back to is root's already.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# The only path it writes: status.db, its -wal and -shm, and the staging copy
# the backup monitor takes beside them before uploading. Everything else on the
# filesystem is read-only to this service.
ReadWritePaths=/opt/power-status
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
